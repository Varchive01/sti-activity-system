# Google Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# SMTP Configuration (e.g., Microsoft 365 / Outlook / Gmail)
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@domain.com"
SMTP_PASSWORD="your_app_password"
SMTP_ENCRYPTION="tls"

FROM_EMAIL="your_email@domain.com"
FROM_NAME="STI Activity System"

# Microsoft OAuth2 Configuration (used for Sign in with Microsoft and Mail.Send)
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_TENANT_ID="common"
OAUTH_REFRESH_TOKEN=""

# Microsoft OneDrive Configuration (Microsoft Graph Files API)
# Reuses existing Azure App Registration (OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET / OAUTH_TENANT_ID)
# Dedicated refresh token with Files.ReadWrite and offline_access (MUST be separate from mail OAUTH_REFRESH_TOKEN)
ONEDRIVE_REFRESH_TOKEN=""
ONEDRIVE_ROOT_FOLDER="STI_Activity_System_Documents"
ONEDRIVE_ENABLED=false

# Google Forms OAuth2 Configuration (for Post-Activity Evaluation Form creation)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_REDIRECT_URI="http://localhost/sti-activity-system/api/google-oauth-callback.php"
